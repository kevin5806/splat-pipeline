# Copia in .env e modifica. Tutte le voci sono opzionali.
PANEL_PORT=8080
VIEWER_PORT=7007
DATA_PATH=./data
# Token del pannello (consigliato se la porta è raggiungibile da altre persone)
PANEL_TOKEN=
# 1 per GPU Pascal (Tesla P4, GTX 10xx): applica la patch a gsplat (build più lunga)
PASCAL_PATCH=0
AUTO_RESUME=1
MAX_UPLOAD_GB=20
